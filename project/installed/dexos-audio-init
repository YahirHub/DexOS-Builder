#!/bin/sh
# WirePlumber already persists the user's PipeWire volume and mute state.
# Never force wpctl volume here: doing so would overwrite that state at login.
# ALSA hardware mixer state is handled by Alpine's OpenRC `alsa` service.
log=/var/log/dexos-audio.log
{
    echo "--- DexOS audio init $(date '+%Y-%m-%d %H:%M:%S' 2>/dev/null || true) ---"
    if [ ! -s /var/lib/alsa/asound.state ]; then
        # First boot only: initialize the card so completely muted firmware
        # defaults do not leave the desktop without audio. The `alsa` service
        # stores the resulting state on shutdown and restores it next boot.
        alsactl init 2>&1 || true
    fi
    echo '--- ALSA cards ---'
    cat /proc/asound/cards 2>&1 || true

    # Wait briefly for WirePlumber only for diagnostics; do not change volume.
    i=0
    while [ "$i" -lt 20 ]; do
        wpctl status >/dev/null 2>&1 && break
        sleep 0.25
        i=$((i + 1))
    done
    echo '--- PipeWire/WirePlumber ---'
    wpctl status 2>&1 || true
} >> "$log" 2>&1
exit 0
