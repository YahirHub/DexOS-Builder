#!/sbin/openrc-run
name="DexOS boot splash finish"
description="Close boot splash once LightDM is running"
depend(){ need lightdm; after lightdm; }
start(){
    [ -r /run/dexos-splash-progress.pid ] && kill "$(cat /run/dexos-splash-progress.pid)" 2>/dev/null || true
    rm -f /run/dexos-splash-progress.pid
    if [ -p /.splash.ctrl ]; then
        printf '100\n' > /.splash.ctrl 2>/dev/null || true
        sleep .35
        printf 'exit\n' > /.splash.ctrl 2>/dev/null || true
    fi
    [ -r /run/dexos-splash-keys.pid ] && kill "$(cat /run/dexos-splash-keys.pid)" 2>/dev/null || true
    rm -f /run/dexos-splash-keys.pid /.splash.ctrl
}
