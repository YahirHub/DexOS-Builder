#!/bin/sh
set -eu

root_spec=$(awk '$2 == "/" {print $1; exit}' /etc/fstab 2>/dev/null || true)
case "$root_spec" in
    UUID=*) root_uuid=${root_spec#UUID=} ;;
    *) exit 0 ;;
esac
[ -n "$root_uuid" ] || exit 0
[ -f /boot/vmlinuz-lts ] || exit 0
[ -f /boot/initramfs-lts ] || exit 0

cat <<EOF_GRUB
menuentry 'DexOS' --class alpine --class gnu-linux --class gnu --class os {
    insmod part_gpt
    insmod part_msdos
    insmod ext2
    search --no-floppy --fs-uuid --set=root $root_uuid
    linux /boot/vmlinuz-lts root=UUID=$root_uuid ro rootfstype=ext4 quiet vt.global_cursor_default=0 modules=virtio,virtio_ring,virtio_pci,virtio_blk,ext4
    initrd /boot/initramfs-lts
}
EOF_GRUB
