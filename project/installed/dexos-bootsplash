#!/sbin/openrc-run
name="DexOS boot splash"
description="Keep DexOS splash visible while OpenRC starts"
depend(){ need localmount; before dbus elogind networkmanager lightdm; }
start(){
    [ -p /.splash.ctrl ] || return 0
    chvt 16 2>/dev/null || true
    printf '42\n' > /.splash.ctrl 2>/dev/null || true
    /usr/local/sbin/dexos-splash-keys >/dev/null 2>&1 &
    echo $! > /run/dexos-splash-keys.pid
    # Barra animada mientras OpenRC termina de levantar servicios. Es sólo un
    # indicador visual; nunca bloquea el arranque ni sustituye el log de tty1.
    (
        p=42
        while [ -p /.splash.ctrl ] && [ "$p" -lt 94 ]; do
            p=$((p + 1))
            printf '%s\n' "$p" > /.splash.ctrl 2>/dev/null || exit 0
            sleep 0.30
        done
    ) >/dev/null 2>&1 &
    echo $! > /run/dexos-splash-progress.pid
}
stop(){
    for f in /run/dexos-splash-keys.pid /run/dexos-splash-progress.pid; do
        [ -r "$f" ] && kill "$(cat "$f")" 2>/dev/null || true
        rm -f "$f"
    done
}
