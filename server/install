#!/bin/sh
set -eu
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH

TARGET=/mnt/dexos-target
PACKAGE_FILE=/usr/share/dexos/server-packages.txt
ONLINE_MAIN=https://dl-cdn.alpinelinux.org/alpine/edge/main
ONLINE_COMMUNITY=https://dl-cdn.alpinelinux.org/alpine/edge/community
MIN_DISK=4294967296
MIN_ROOT=1073741824
EFI_GUID=c12a7328-f81f-11d2-ba4b-00a0c93ec93b
BIOS_GUID=21686148-6449-6e6f-744e-656564454649
LINUX_GUID=0fc63daf-8483-4772-8e79-3d69d8477de4
MSR_GUID=e3c9e316-0b5c-4db8-817d-f92df00215ae
WINRE_GUID=de94bba4-06d1-4d40-a16a-bfd50179d6ac
MOUNTED=0
LOCKED=0
INSTALL_LOCK=/run/dexos-install.lock
WORK=/tmp/dexos-installer.$$
mkdir -p "$WORK"

say() { printf '\n==> %s\n' "$*"; }
warn() { printf '\nAVISO: %s\n' "$*" >&2; }
die() { printf '\nERROR: %s\n' "$*" >&2; exit 1; }
ask() { printf '%s' "$1"; IFS= read -r REPLY; }
secret() {
    printf '%s' "$1"
    stty -echo 2>/dev/null || true
    IFS= read -r REPLY
    stty echo 2>/dev/null || true
    printf '\n'
}
confirm() {
    printf '%s [s/N]: ' "$1"
    IFS= read -r answer
    case "$answer" in s|S|si|SI|sí|Sí|y|Y|yes|YES) return 0 ;; *) return 1 ;; esac
}
cleanup() {
    if [ "$MOUNTED" -eq 1 ]; then
        umount -R "$TARGET" >/dev/null 2>&1 || true
        MOUNTED=0
    fi
    rm -rf "$WORK" >/dev/null 2>&1 || true
    if [ "$LOCKED" -eq 1 ]; then
        rm -rf "$INSTALL_LOCK" >/dev/null 2>&1 || true
        LOCKED=0
    fi
}
trap cleanup EXIT HUP INT TERM

case "${1:-}" in
    ''|--wifi|--check|--inventory|--batch|--help|-h) ;;
    *)
        if [ -x /usr/bin/install ] && [ "$0" != /usr/bin/install ]; then
            exec /usr/bin/install "$@"
        fi
        die "Opción desconocida: $1"
        ;;
esac

if [ "${1:-}" = --help ] || [ "${1:-}" = -h ]; then
    cat <<'EOF'
DexOS Server installer

  install          Ejecuta el asistente inteligente de instalación offline.
  install --wifi   Ejecuta únicamente el asistente de Wi-Fi.
  install --check      Verifica medio, módulos, paquetes y discos sin modificar nada.
  install --inventory  Lista discos/particiones en TSV para el instalador web.
  install --batch      Instala sin prompts usando variables DEXOS_* validadas.
EOF
    exit 0
fi

if [ "$(id -u)" -ne 0 ]; then
    if command -v doas >/dev/null 2>&1; then exec doas "$0" "$@"; fi
    die "El instalador necesita privilegios root."
fi

find_repo() {
    for arch_repo in /media/*/apks/x86_64 /media/*/*/apks/x86_64 /run/media/*/apks/x86_64; do
        if [ -f "$arch_repo/APKINDEX.tar.gz" ]; then
            dirname "$arch_repo"
            return 0
        fi
    done
    return 1
}

packages() {
    [ -f "$PACKAGE_FILE" ] || die "Falta $PACKAGE_FILE"
    sed -e 's/#.*$//' -e '/^[[:space:]]*$/d' "$PACKAGE_FILE"
}

require_cmds() {
    missing=''
    for cmd in apk lsblk sfdisk blockdev partx wipefs mkfs.vfat mkfs.ext4 mount umount chroot blkid grub-install nmcli rc-service findmnt mknod modprobe uuidgen base64; do
        command -v "$cmd" >/dev/null 2>&1 || missing="$missing $cmd"
    done
    [ -z "$missing" ] || die "Faltan herramientas del Live:$missing"
}

ensure_runtime_modules() {
    rc-service modloop status >/dev/null 2>&1 || rc-service modloop start >/dev/null 2>&1 || true
    rc-service hwdrivers status >/dev/null 2>&1 || rc-service hwdrivers start >/dev/null 2>&1 || true
    modprobe ext4 >/dev/null 2>&1 || die "No se pudo cargar ext4 desde modloop."
    modprobe vfat >/dev/null 2>&1 || true
}

ensure_networkmanager() {
    rc-service dbus status >/dev/null 2>&1 || rc-service dbus start >/dev/null 2>&1 || true
    rc-service networkmanager status >/dev/null 2>&1 || rc-service networkmanager start >/dev/null 2>&1 || true
}

wifi_assistant() {
    say "Wi-Fi para el sistema instalado"
    wifi_ssid=''
    wifi_password=''
    confirm "¿Quieres dejar una red Wi-Fi configurada para después del primer reinicio?" || return 0
    ask "SSID exacto: "
    wifi_ssid=$REPLY
    [ -n "$wifi_ssid" ] || die "El SSID no puede estar vacío."
    validate_wifi_config "$wifi_ssid" '' || die "SSID Wi-Fi inválido o demasiado largo."
    secret "Contraseña Wi-Fi (Enter si la red es abierta): "
    wifi_password=$REPLY
    validate_wifi_config "$wifi_ssid" "$wifi_password" || die "La contraseña Wi-Fi debe tener 8-63 caracteres, o 64 dígitos hexadecimales; Enter sólo para una red abierta."
    echo "La red se intentará conectar después de reiniciar; el Live no desconectará Dex-Installer."
}

preflight() {
    require_cmds
    ensure_runtime_modules
    repo=$(find_repo) || die "No se encontró el repositorio APK offline de DexOS Server."
    package_words=$(packages | tr '\n' ' ')
    [ -n "$package_words" ] || die "La lista de paquetes está vacía."
    say "Verificando repositorio offline"
    echo "Repositorio: $repo"
    apk add --simulate --no-network --repositories-file /dev/null \
        --repository "$repo" $package_words >/dev/null \
        || die "El repositorio offline no contiene todas las dependencias del sistema instalado."
}

validate_hostname() {
    printf '%s\n' "$1" | grep -Eq '^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$'
}
validate_user() {
    [ "$1" != root ] && printf '%s\n' "$1" | grep -Eq '^[a-z_][a-z0-9_-]{0,30}$'
}
validate_password() {
    [ ${#1} -ge 8 ] || return 1
    case "$1" in *:*) return 1 ;; esac
    return 0
}
validate_timezone() {
    case "$1" in ''|/*|*'..'*) return 1 ;; esac
    [ -f "/usr/share/zoneinfo/$1" ]
}

validate_wifi_config() {
    ssid_value=$1
    pass_value=${2:-}
    [ -n "$ssid_value" ] || { [ -z "$pass_value" ]; return; }
    ssid_bytes=$(printf '%s' "$ssid_value" | wc -c | tr -d ' ')
    [ "$ssid_bytes" -le 32 ] || return 1
    printf '%s' "$ssid_value" | LC_ALL=C grep -q '[[:cntrl:]]' && return 1
    [ -z "$pass_value" ] && return 0
    printf '%s' "$pass_value" | LC_ALL=C grep -q '[[:cntrl:]]' && return 1
    pass_len=${#pass_value}
    [ "$pass_len" -ge 8 ] || return 1
    if [ "$pass_len" -eq 64 ]; then
        printf '%s' "$pass_value" | grep -Eq '^[0-9A-Fa-f]{64}$'
        return $?
    fi
    [ "$pass_len" -le 63 ]
}

normalize_mdns_name() {
    name=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')
    name=${name%.}
    case "$name" in *.local) name=${name%.local} ;; esac
    validate_hostname "$name" || die "Nombre inválido. Usa letras, números y guiones; .local es opcional."
    hostname=$name
    mdns_name=$name.local
}

collect_identity() {
    say "Identidad del servidor"
    ask "Nombre del servidor/mDNS [dexos-server.local]: "
    normalize_mdns_name "${REPLY:-dexos-server.local}"
    echo "El servidor se anunciará como: $mdns_name"

    ask "Usuario administrador [admin]: "
    admin_user=${REPLY:-admin}
    validate_user "$admin_user" || die "Usuario no válido."

    secret "Contraseña de $admin_user (mínimo 8 caracteres): "
    admin_password=$REPLY
    validate_password "$admin_password" || die "La contraseña debe tener al menos 8 caracteres y no contener ':'."
    secret "Repite la contraseña de $admin_user: "
    [ "$REPLY" = "$admin_password" ] || die "Las contraseñas del usuario no coinciden."

    secret "Contraseña de root [Enter = usar la de $admin_user]: "
    if [ -z "$REPLY" ]; then
        root_password=$admin_password
        echo "root usará la misma contraseña que $admin_user."
    else
        root_password=$REPLY
        validate_password "$root_password" || die "La contraseña root debe tener al menos 8 caracteres y no contener ':'."
        secret "Repite la contraseña de root: "
        [ "$REPLY" = "$root_password" ] || die "Las contraseñas root no coinciden."
    fi

    if confirm "¿Permitir acceso root directamente por SSH?"; then
        ssh_root_login=yes
    else
        ssh_root_login=no
    fi

    ask "Zona horaria [UTC] (ej. America/Mexico_City): "
    timezone=${REPLY:-UTC}
    validate_timezone "$timezone" || die "Zona horaria no disponible o no válida: $timezone"
}

installation_media_disk() {
    repo=$(find_repo 2>/dev/null || true)
    [ -n "$repo" ] || return 0
    src=$(findmnt -n -o SOURCE -T "$repo" 2>/dev/null || true)
    case "$src" in
        /dev/*)
            type=$(lsblk -dnro TYPE "$src" 2>/dev/null | tr -d ' ')
            if [ "$type" = part ]; then
                pk=$(lsblk -dnro PKNAME "$src" 2>/dev/null | tr -d ' ')
                [ -n "$pk" ] && printf '/dev/%s\n' "$pk"
            elif [ "$type" = disk ]; then
                printf '%s\n' "$src"
            fi
            ;;
    esac
}

make_disk_list() {
    file=$1
    live_disk=$(installation_media_disk || true)
    : > "$file"
    lsblk -dnpr -o NAME,TYPE,RO | awk '$2=="disk" && $3==0 {print $1}' | while IFS= read -r dev; do
        [ -n "$live_disk" ] && [ "$dev" = "$live_disk" ] && continue
        printf '%s\n' "$dev"
    done > "$file"
}

print_disk_menu() {
    file=$1
    idx=1
    while IFS= read -r dev; do
        meta=$(lsblk -dn -o SIZE,MODEL,TRAN "$dev" 2>/dev/null | sed 's/[[:space:]]*$//')
        printf ' %d) %-14s %s\n' "$idx" "$dev" "$meta"
        idx=$((idx + 1))
    done < "$file"
}

select_disk() {
    file="$WORK/disks"
    make_disk_list "$file"
    [ -s "$file" ] || die "No hay discos instalables; el medio Live se excluye automáticamente."
    say "Discos disponibles"
    print_disk_menu "$file"
    count=$(wc -l < "$file" | tr -d ' ')
    while :; do
        ask "Selecciona el disco [1-$count]: "
        case "$REPLY" in ''|*[!0-9]*) echo "Selección inválida."; continue ;; esac
        [ "$REPLY" -ge 1 ] && [ "$REPLY" -le "$count" ] || { echo "Fuera de rango."; continue; }
        disk=$(sed -n "${REPLY}p" "$file")
        break
    done
}

is_efi_guid() {
    pt=$(lsblk -dnro PARTTYPE "$1" 2>/dev/null | tr '[:upper:]' '[:lower:]' | tr -d ' ')
    [ "$pt" = "$EFI_GUID" ]
}

is_bios_guid() {
    pt=$(lsblk -dnro PARTTYPE "$1" 2>/dev/null | tr '[:upper:]' '[:lower:]' | tr -d ' ')
    [ "$pt" = "$BIOS_GUID" ]
}

is_reserved_windows_guid() {
    pt=$(lsblk -dnro PARTTYPE "$1" 2>/dev/null | tr '[:upper:]' '[:lower:]' | tr -d ' ')
    [ "$pt" = "$MSR_GUID" ] || [ "$pt" = "$WINRE_GUID" ]
}

partition_nodes_from_table() {
    # Enumerate the partition table itself instead of relying on filesystem
    # probing. This is important for partitions created from Windows and left
    # completely unformatted: they have PARTUUID/PARTTYPE but no FSTYPE.
    refresh_partition_nodes
    nrs=$(partx -g -o NR "$disk" 2>/dev/null | awk '$1 ~ /^[0-9]+$/ {print $1}' || true)
    if [ -n "$nrs" ]; then
        for nr in $nrs; do
            part=$(part_path "$disk" "$nr")
            if ! ensure_block_node "$part"; then
                partx -a --nr "$nr" "$disk" >/dev/null 2>&1 || partx -u --nr "$nr" "$disk" >/dev/null 2>&1 || true
                command -v udevadm >/dev/null 2>&1 && udevadm settle --timeout=5 >/dev/null 2>&1 || true
                ensure_block_node "$part" || continue
            fi
            printf '%s\n' "$part"
        done
        return 0
    fi

    # Fallback for unusual partition tables/drivers where partx cannot list.
    lsblk -npr -o NAME,TYPE "$disk" 2>/dev/null | awk '$2=="part" {print $1}'
}

free_regions_from_table() {
    # sfdisk --list-free reads gaps from the partition table itself. This also
    # covers the common Windows workflow "Shrink volume", which leaves
    # unallocated space but does not create a /dev partition node yet.
    sector_size=$(blockdev --getss "$disk" 2>/dev/null || printf '512\n')
    case "$sector_size" in ''|*[!0-9]*) sector_size=512 ;; esac
    sfdisk --list-free "$disk" 2>/dev/null | awk -v ss="$sector_size" -v min="$MIN_ROOT" '
        $1 ~ /^[0-9]+$/ && $2 ~ /^[0-9]+$/ && $3 ~ /^[0-9]+$/ {
            bytes = $3 * ss
            if (bytes >= min) printf "%s\t%s\t%.0f\n", $1, $3, bytes
        }
    '
}

free_region_valid() {
    want_start=$1
    want_sectors=$2
    case "$want_start:$want_sectors" in
        *[!0-9:]*|:*|*:) return 1 ;;
    esac
    [ "$want_sectors" -gt 0 ] || return 1
    free_regions_from_table | awk -F '\t' -v s="$want_start" -v n="$want_sectors" '
        $1 == s && $2 == n { found=1 }
        END { exit(found ? 0 : 1) }
    '
}

human_bytes() {
    awk -v b="${1:-0}" 'BEGIN {
        split("B KiB MiB GiB TiB", u, " ")
        i=1
        while (b >= 1024 && i < 5) { b/=1024; i++ }
        if (i <= 2) printf "%.0f %s", b, u[i]; else printf "%.1f %s", b, u[i]
    }'
}

partition_parent_disk() {
    pk=$(lsblk -dnro PKNAME "$1" 2>/dev/null | tr -d ' ')
    [ -n "$pk" ] || return 1
    printf '/dev/%s\n' "$pk"
}

root_partition_reason() {
    part=$1
    type=$(lsblk -dnro TYPE "$part" 2>/dev/null | tr -d ' ')
    [ "$type" = part ] || { printf 'no-es-particion\n'; return 0; }
    ro=$(lsblk -dnro RO "$part" 2>/dev/null | tr -d ' ')
    [ "$ro" = 0 ] || { printf 'solo-lectura\n'; return 0; }
    parent=$(partition_parent_disk "$part" 2>/dev/null || true)
    [ "$parent" = "$disk" ] || { printf 'otro-disco\n'; return 0; }
    is_efi_guid "$part" && { printf 'particion-efi\n'; return 0; }
    is_bios_guid "$part" && { printf 'bios-boot\n'; return 0; }
    is_reserved_windows_guid "$part" && { printf 'reservada-windows\n'; return 0; }
    mnt=$(lsblk -dnro MOUNTPOINTS "$part" 2>/dev/null | tr -d '[:space:]')
    [ -z "$mnt" ] || { printf 'montada\n'; return 0; }
    size=$(lsblk -bdnro SIZE "$part" 2>/dev/null | tr -d ' ')
    [ "${size:-0}" -ge "$MIN_ROOT" ] || { printf 'menor-1GiB\n'; return 0; }
    printf 'ok\n'
}

root_partition_eligible() {
    [ "$(root_partition_reason "$1")" = ok ]
}

efi_partition_candidate() {
    part=$1
    [ "$(partition_parent_disk "$part" 2>/dev/null || true)" = "$disk" ] || return 1
    fs=$(lsblk -dnro FSTYPE "$part" 2>/dev/null | tr '[:upper:]' '[:lower:]' | tr -d ' ')
    is_efi_guid "$part" || [ "$fs" = vfat ] || [ "$fs" = fat ] || [ "$fs" = fat32 ]
}

make_root_partition_list() {
    file=$1
    : > "$file"
    # Do not require FSTYPE. Read GPT/MBR entries directly so a partition that
    # Windows created but never formatted is still visible and selectable.
    partition_nodes_from_table | while IFS= read -r part; do
        root_partition_eligible "$part" || continue
        printf '%s\n' "$part"
    done > "$file"
}

print_partition_menu() {
    file=$1
    idx=1
    while IFS= read -r part; do
        size=$(lsblk -dnro SIZE "$part" 2>/dev/null | sed 's/[[:space:]]*$//')
        fs=$(lsblk -dnro FSTYPE "$part" 2>/dev/null | sed 's/[[:space:]]*$//')
        label=$(lsblk -dnro LABEL "$part" 2>/dev/null | sed 's/[[:space:]]*$//')
        partlabel=$(lsblk -dnro PARTLABEL "$part" 2>/dev/null | sed 's/[[:space:]]*$//')
        [ -n "$fs" ] || fs='<sin formato>'
        meta="$size $fs"
        [ -z "$label" ] || meta="$meta $label"
        [ -z "$partlabel" ] || meta="$meta [$partlabel]"
        printf ' %d) %-16s %s\n' "$idx" "$part" "$meta"
        idx=$((idx + 1))
    done < "$file"
}

select_root_partition() {
    part_file="$WORK/root-parts"
    target_file="$WORK/root-targets"
    make_root_partition_list "$part_file"
    : > "$target_file"
    while IFS= read -r part; do
        [ -n "$part" ] && printf 'PART\t%s\n' "$part" >> "$target_file"
    done < "$part_file"
    free_regions_from_table | while IFS='	' read -r free_start free_sectors free_bytes; do
        [ -n "$free_start" ] || continue
        printf 'FREE\t%s\t%s\t%s\n' "$free_start" "$free_sectors" "$free_bytes" >> "$target_file"
    done

    [ -s "$target_file" ] || die "No hay particiones ni espacio no asignado utilizable de al menos 1 GiB en $disk."
    say "Destino para DexOS Server"
    echo "Puedes elegir una partición existente o un hueco no asignado. Sólo el destino elegido se modificará."
    idx=1
    while IFS='	' read -r kind a b c; do
        if [ "$kind" = PART ]; then
            size=$(lsblk -dnro SIZE "$a" 2>/dev/null | sed 's/[[:space:]]*$//')
            fs=$(lsblk -dnro FSTYPE "$a" 2>/dev/null | sed 's/[[:space:]]*$//')
            label=$(lsblk -dnro LABEL "$a" 2>/dev/null | sed 's/[[:space:]]*$//')
            partlabel=$(lsblk -dnro PARTLABEL "$a" 2>/dev/null | sed 's/[[:space:]]*$//')
            [ -n "$fs" ] || fs='<sin formato>'
            meta="$size $fs"
            [ -z "$label" ] || meta="$meta $label"
            [ -z "$partlabel" ] || meta="$meta [$partlabel]"
            printf ' %d) %-16s %s\n' "$idx" "$a" "$meta"
        else
            printf ' %d) %-16s %s\n' "$idx" '<no asignado>' "$(human_bytes "$c") — se creará una partición nueva"
        fi
        idx=$((idx + 1))
    done < "$target_file"

    count=$(wc -l < "$target_file" | tr -d ' ')
    while :; do
        ask "Selecciona el destino raíz [1-$count]: "
        case "$REPLY" in ''|*[!0-9]*) echo "Selección inválida."; continue ;; esac
        [ "$REPLY" -ge 1 ] && [ "$REPLY" -le "$count" ] || { echo "Fuera de rango."; continue; }
        row=$(sed -n "${REPLY}p" "$target_file")
        IFS='	' read -r target_kind target_a target_b target_c <<EOF
$row
EOF
        if [ "$target_kind" = PART ]; then
            root_part=$target_a
            root_free_start=''
            root_free_sectors=''
            root_from_free=0
        else
            root_part=''
            root_free_start=$target_a
            root_free_sectors=$target_b
            root_from_free=1
        fi
        break
    done
}

make_efi_partition_list() {
    file=$1
    : > "$file"
    partition_nodes_from_table | while IFS= read -r part; do
        [ "$part" = "$root_part" ] && continue
        ro=$(lsblk -dnro RO "$part" 2>/dev/null | tr -d ' ')
        [ "$ro" = 0 ] || continue
        if efi_partition_candidate "$part"; then
            printf '%s\n' "$part"
        fi
        :
    done > "$file"
    return 0
}

select_efi_partition() {
    file="$WORK/efi-parts"
    make_efi_partition_list "$file"
    efi_part=''
    if [ ! -s "$file" ]; then
        echo "No se detectó una partición EFI/FAT en $disk."
        return 0
    fi
    say "Partición de arranque EFI"
    echo "Se reutilizará sin formatearla; los cargadores existentes se conservan."
    print_partition_menu "$file"
    echo " 0) Ninguna (solo BIOS si el disco lo permite)"
    count=$(wc -l < "$file" | tr -d ' ')
    default=''
    [ "$count" -eq 1 ] && default=1
    while :; do
        if [ -n "$default" ]; then
            ask "Selecciona la ESP [0-$count, Enter=$default]: "
            choice=${REPLY:-$default}
        else
            ask "Selecciona la ESP [0-$count]: "
            choice=$REPLY
        fi
        case "$choice" in *[!0-9]*|'') echo "Selección inválida."; continue ;; esac
        [ "$choice" -ge 0 ] && [ "$choice" -le "$count" ] || { echo "Fuera de rango."; continue; }
        [ "$choice" -eq 0 ] && { efi_part=''; break; }
        efi_part=$(sed -n "${choice}p" "$file")
        fs=$(lsblk -dnro FSTYPE "$efi_part" 2>/dev/null | tr '[:upper:]' '[:lower:]' | tr -d ' ')
        case "$fs" in vfat|fat|fat32) ;; *) echo "$efi_part no contiene un filesystem FAT utilizable como ESP."; continue ;; esac
        break
    done
}

disk_bios_capable() {
    pttype=$(blkid -p -s PTTYPE -o value "$disk" 2>/dev/null | tr '[:upper:]' '[:lower:]' || true)
    case "$pttype" in dos|msdos) return 0 ;; esac
    [ "$pttype" = gpt ] || return 1
    lsblk -nro PARTTYPE "$disk" 2>/dev/null \
        | tr '[:upper:]' '[:lower:]' \
        | tr -d ' ' \
        | grep -qx "$BIOS_GUID"
}

validate_boot_plan() {
    bios_install=0
    efi_install=0
    disk_bios_capable && bios_install=1 || true
    [ -n "${efi_part:-}" ] && efi_install=1
    if [ -d /sys/firmware/efi ] && [ "$efi_install" -ne 1 ]; then
        die "El Live arrancó en UEFI; selecciona una partición EFI para garantizar el arranque."
    fi
    [ "$bios_install" -eq 1 ] || [ "$efi_install" -eq 1 ] \
        || die "No hay un destino de arranque válido: falta ESP y el disco no permite GRUB BIOS."
}

choose_layout() {
    say "Modo de instalación"
    echo " 1) Usar un disco completo (borra ese disco)"
    echo " 2) Coexistir con otro sistema usando particiones existentes"
    while :; do
        ask "Selecciona [1-2]: "
        case "$REPLY" in 1) install_mode=whole; break ;; 2) install_mode=coexist; break ;; *) echo "Elige 1 o 2." ;; esac
    done

    select_disk
    if [ "$install_mode" = whole ]; then
        disk_size=$(lsblk -bdnro SIZE "$disk" 2>/dev/null | tr -d ' ')
        [ "${disk_size:-0}" -ge "$MIN_DISK" ] || die "DexOS Server requiere un disco de al menos 4 GiB."
        if lsblk -nr -o MOUNTPOINTS "$disk" | grep -q '[^[:space:]]'; then
            die "$disk contiene una partición montada. Desmóntala o usa modo coexistencia."
        fi
        root_part=''
        efi_part=''
        bios_install=1
        efi_install=1
    else
        select_root_partition
        select_efi_partition
        validate_boot_plan
    fi
}

part_path() {
    case "$1" in *[0-9]) printf '%sp%s\n' "$1" "$2" ;; *) printf '%s%s\n' "$1" "$2" ;; esac
}

ensure_block_node() {
    path=$1
    [ -b "$path" ] && return 0
    name=${path#/dev/}
    sysdev="/sys/class/block/$name/dev"
    if [ -r "$sysdev" ]; then
        mm=$(cat "$sysdev")
        major=${mm%%:*}
        minor=${mm#*:}
        rm -f "$path" 2>/dev/null || true
        mknod "$path" b "$major" "$minor" 2>/dev/null || true
    fi
    [ -b "$path" ]
}

refresh_partition_nodes() {
    sync
    blockdev --rereadpt "$disk" >/dev/null 2>&1 || true
    partx -u "$disk" >/dev/null 2>&1 || partx -a "$disk" >/dev/null 2>&1 || true
    command -v udevadm >/dev/null 2>&1 && udevadm trigger --subsystem-match=block >/dev/null 2>&1 || true
    command -v udevadm >/dev/null 2>&1 && udevadm settle --timeout=5 >/dev/null 2>&1 || true
    command -v mdev >/dev/null 2>&1 && mdev -s >/dev/null 2>&1 || true
}

wait_block() {
    path=$1
    count=0
    while [ "$count" -lt 30 ]; do
        ensure_block_node "$path" && return 0
        refresh_partition_nodes
        ensure_block_node "$path" && return 0
        sleep 1
        count=$((count + 1))
    done
    die "No apareció el dispositivo $path después de actualizar la tabla de particiones."
}

create_root_partition_from_free() {
    start=${root_free_start:-}
    sectors=${root_free_sectors:-}
    free_region_valid "$start" "$sectors"         || die "El espacio no asignado cambió desde la última revisión. Actualiza el inventario y vuelve a confirmar."

    pttype=$(blkid -p -s PTTYPE -o value "$disk" 2>/dev/null | tr '[:upper:]' '[:lower:]' || true)
    say "Creando partición DexOS dentro del espacio no asignado"
    case "$pttype" in
        gpt)
            printf 'start=%s,size=%s,type=%s,name="DexOS Server"\n' "$start" "$sectors" "$LINUX_GUID"                 | sfdisk --append --wipe never --wipe-partitions never "$disk" >/dev/null                 || die "No se pudo crear la partición DexOS dentro del espacio GPT seleccionado."
            ;;
        dos|msdos)
            printf 'start=%s,size=%s,type=83\n' "$start" "$sectors"                 | sfdisk --append --wipe never --wipe-partitions never "$disk" >/dev/null                 || die "No se pudo crear la partición DexOS dentro del espacio MBR seleccionado."
            ;;
        *)
            die "La tabla de particiones '$pttype' no permite crear automáticamente una raíz en espacio no asignado."
            ;;
    esac

    refresh_partition_nodes
    nr=$(partx -g -o NR,START,SECTORS "$disk" 2>/dev/null | awk -v s="$start" -v n="$sectors" '$2 == s && $3 == n {print $1; exit}')
    [ -n "$nr" ] || die "La nueva partición existe, pero no se pudo identificar su número en $disk."
    root_part=$(part_path "$disk" "$nr")
    wait_block "$root_part"
    root_from_free=0
}

format_root_ext4() {
    part=$1
    wipefs -a "$part"
    wait_block "$part"
    mkfs.ext4 -F -L DexOS-Server "$part"
    wait_block "$part"

    root_fstype=$(blkid -p -s TYPE -o value "$part" 2>/dev/null || true)
    [ "$root_fstype" = ext4 ] || die "El formato de $part no quedó como ext4 (detectado: ${root_fstype:-desconocido})."
}

verify_mounted_root_ext4() {
    mounted_fstype=$(findmnt -nro FSTYPE "$TARGET" 2>/dev/null || true)
    [ "$mounted_fstype" = ext4 ] || die "La raíz montada no es ext4 (detectado: ${mounted_fstype:-desconocido})."
}

prepare_storage() {
    ensure_runtime_modules
    if [ "$install_mode" = whole ]; then
        bios_part=$(part_path "$disk" 1)
        efi_part=$(part_path "$disk" 2)
        root_part=$(part_path "$disk" 3)
        say "Creando GPT BIOS + UEFI"
        wipefs -a "$disk"
        sfdisk --wipe always --wipe-partitions always "$disk" <<EOF
label: gpt
size=2M, type=$BIOS_GUID
size=512M, type=$EFI_GUID
type=$LINUX_GUID
EOF
        refresh_partition_nodes
        wait_block "$bios_part"
        wait_block "$efi_part"
        wait_block "$root_part"
        say "Formateando particiones nuevas"
        wait_block "$efi_part"
        mkfs.vfat -F 32 -n DEXOS_EFI "$efi_part"
        refresh_partition_nodes
        wait_block "$root_part"
        format_root_ext4 "$root_part"
        bios_install=1
        efi_install=1
    else
        if [ "${root_from_free:-0}" -eq 1 ]; then
            echo "Se conservarán las particiones existentes; se creará una nueva raíz sólo dentro del espacio no asignado seleccionado."
            create_root_partition_from_free
        else
            say "Preparando la partición raíz seleccionada"
            echo "Se conservarán todas las demás particiones, incluida: ${efi_part:-ninguna ESP seleccionada}."
            wait_block "$root_part"
        fi
        format_root_ext4 "$root_part"
    fi
}

mount_target() {
    umount -R "$TARGET" >/dev/null 2>&1 || true
    rm -rf "$TARGET"
    mkdir -p "$TARGET"
    wait_block "$root_part"
    mount -t ext4 "$root_part" "$TARGET"
    MOUNTED=1
    verify_mounted_root_ext4
    mkdir -p "$TARGET/boot/efi"
    if [ -n "${efi_part:-}" ]; then
        wait_block "$efi_part"
        mount "$efi_part" "$TARGET/boot/efi"
    fi
    for src in proc sys dev run; do
        mkdir -p "$TARGET/$src"
        mount --rbind "/$src" "$TARGET/$src"
        mount --make-rslave "$TARGET/$src"
    done
}

install_offline_packages() {
    repo=$(find_repo) || die "El repositorio APK de la ISO desapareció."
    package_words=$(packages | tr '\n' ' ')
    mkdir -p "$TARGET/etc/apk/keys"
    cp /etc/apk/keys/* "$TARGET/etc/apk/keys/"
    say "Instalando paquetes desde la ISO (sin Internet)"
    apk add --root "$TARGET" --initdb --arch x86_64 \
        --keys-dir /etc/apk/keys --no-network --repositories-file /dev/null \
        --repository "$repo" $package_words
    # DexOS uses its own installer. Keep alpine-conf for its useful utilities,
    # but remove the generic setup-alpine entry point from the installed OS.
    rm -f "$TARGET/usr/sbin/setup-alpine"
}

write_target_config() {
    say "Configurando DexOS Server"
    mkdir -p "$TARGET/etc/apk" "$TARGET/etc/ssh/sshd_config.d" "$TARGET/etc/avahi" \
        "$TARGET/etc/doas.d" "$TARGET/etc/NetworkManager/conf.d" \
        "$TARGET/etc/NetworkManager/system-connections" "$TARGET/usr/local/sbin" "$TARGET/usr/local/bin" \
        "$TARGET/etc/grub.d" "$TARGET/etc/profile.d"

    cat > "$TARGET/etc/apk/repositories" <<EOF
$ONLINE_MAIN
$ONLINE_COMMUNITY
EOF
    printf '%s\n' "$hostname" > "$TARGET/etc/hostname"
    cat > "$TARGET/etc/hosts" <<EOF
127.0.0.1 localhost localhost.localdomain
127.0.1.1 $hostname $hostname.localdomain
::1 localhost localhost.localdomain
EOF
    ln -sf "/usr/share/zoneinfo/$timezone" "$TARGET/etc/localtime"
    printf '%s\n' "$timezone" > "$TARGET/etc/timezone"

    cat > "$TARGET/etc/os-release" <<'EOF'
NAME="DexOS Server"
PRETTY_NAME="DexOS Server"
ID=dexos-server
ID_LIKE=alpine
VERSION_ID="edge"
VERSION="edge"
EOF
    cat > "$TARGET/etc/issue" <<'EOF'
DexOS Server \n (Alpine Linux) \l
EOF
    cat > "$TARGET/etc/motd" <<EOF
DexOS Server
mDNS: $mdns_name
Network: wifi  (o nmcli)
Disk dashboard: diskinfo
Cambiar arranque predeterminado: boot-order
Regenerar GRUB y detectar otros SO: grub-update
EOF
    cat > "$TARGET/etc/ssh/sshd_config.d/10-dexos-server.conf" <<EOF
PasswordAuthentication yes
PermitRootLogin $ssh_root_login
PermitEmptyPasswords no
UseDNS no
EOF
    cat > "$TARGET/etc/avahi/avahi-daemon.conf" <<EOF
[server]
host-name=$hostname
domain-name=local
use-ipv4=yes
use-ipv6=yes
[wide-area]
enable-wide-area=no
[publish]
publish-addresses=yes
publish-workstation=no
EOF
    cat > "$TARGET/etc/doas.d/10-wheel.conf" <<'EOF'
permit persist :wheel
EOF
    chmod 0600 "$TARGET/etc/doas.d/10-wheel.conf"

    cat > "$TARGET/etc/NetworkManager/conf.d/10-dexos-network.conf" <<'EOF'
[main]
plugins=keyfile
rc-manager=file
dns=default

[ifupdown]
managed=true
EOF
    cat > "$TARGET/etc/resolv.conf" <<'EOF'
# Fallback DNS; NetworkManager replaces this after DHCP/Wi-Fi connects.
nameserver 1.1.1.1
nameserver 8.8.8.8
EOF

    chroot "$TARGET" /usr/sbin/adduser -D -s /bin/ash "$admin_user"
    chroot "$TARGET" /usr/sbin/addgroup "$admin_user" wheel >/dev/null 2>&1 || true
    chroot "$TARGET" /usr/sbin/addgroup "$admin_user" plugdev >/dev/null 2>&1 || true
    printf '%s:%s\nroot:%s\n' "$admin_user" "$admin_password" "$root_password" \
        | chroot "$TARGET" /usr/sbin/chpasswd
    unset admin_password root_password

    chroot "$TARGET" /usr/bin/ssh-keygen -A >/dev/null 2>&1 || true
    chroot "$TARGET" /sbin/rc-update del mdev sysinit >/dev/null 2>&1 || true
    for svc in udev udev-trigger udev-settle; do
        chroot "$TARGET" /sbin/rc-update add "$svc" sysinit >/dev/null 2>&1 || true
    done
    for svc in dbus networkmanager sshd avahi-daemon udev-postmount; do
        chroot "$TARGET" /sbin/rc-update add "$svc" default >/dev/null 2>&1 || true
    done
    chroot "$TARGET" /sbin/rc-update del networking default >/dev/null 2>&1 || true
    chroot "$TARGET" /sbin/rc-update del dhcpcd default >/dev/null 2>&1 || true
    mkdir -p "$TARGET/etc/conf.d"
    cat > "$TARGET/etc/conf.d/networkmanager" <<'EOF'
# NetworkManager Wi-Fi on Alpine uses the wpa_supplicant D-Bus service.
rc_need="wpa_supplicant"
EOF
    chroot "$TARGET" /sbin/rc-update add wpa_supplicant default >/dev/null 2>&1         || die "No se pudo habilitar wpa_supplicant para NetworkManager."

    installed_assets=/usr/share/dexos/installed
    [ -x "$installed_assets/wifi" ] || die "Falta la herramienta wifi."
    [ -x "$installed_assets/diskinfo" ] || die "Falta diskinfo."
    cp "$installed_assets/wifi" "$TARGET/usr/local/bin/wifi"
    cp "$installed_assets/diskinfo" "$TARGET/usr/local/bin/diskinfo"
    cp "$installed_assets/10-dexos-diskinfo.sh" "$TARGET/etc/profile.d/10-dexos-diskinfo.sh"
    chmod 0755 "$TARGET/usr/local/bin/wifi" "$TARGET/usr/local/bin/diskinfo"
    chmod 0644 "$TARGET/etc/profile.d/10-dexos-diskinfo.sh"

    if [ -d /etc/NetworkManager/system-connections ]; then
        for profile in /etc/NetworkManager/system-connections/*; do
            [ -f "$profile" ] || continue
            case "$(basename "$profile" | tr '[:upper:]' '[:lower:]')" in
                *dex-installer*) continue ;;
            esac
            cp -a "$profile" "$TARGET/etc/NetworkManager/system-connections/" 2>/dev/null || true
        done
    fi
    rm -f "$TARGET/etc/NetworkManager/system-connections/dexos-wifi.nmconnection"
    if [ -n "${wifi_ssid:-}" ]; then
        wifi_uuid=$(uuidgen)
        wifi_ssid_key=$(printf '%s' "$wifi_ssid" | sed 's/\\/\\\\/g; s/;/\\;/g')
        wifi_password_key=$(printf '%s' "${wifi_password:-}" | sed 's/\\/\\\\/g; s/;/\\;/g')
        cat > "$TARGET/etc/NetworkManager/system-connections/dexos-wifi.nmconnection" <<EOF
[connection]
id=DexOS WiFi
uuid=$wifi_uuid
type=wifi
autoconnect=true
autoconnect-priority=80

[wifi]
mode=infrastructure
ssid=$wifi_ssid_key
hidden=true
powersave=2
EOF
        if [ -n "${wifi_password:-}" ]; then
            cat >> "$TARGET/etc/NetworkManager/system-connections/dexos-wifi.nmconnection" <<EOF

[wifi-security]
key-mgmt=wpa-psk
psk=$wifi_password_key
EOF
        fi
        cat >> "$TARGET/etc/NetworkManager/system-connections/dexos-wifi.nmconnection" <<'EOF'

[ipv4]
method=auto

[ipv6]
method=auto
addr-gen-mode=default

[proxy]
EOF
        chmod 0600 "$TARGET/etc/NetworkManager/system-connections/dexos-wifi.nmconnection"
        unset wifi_password wifi_password_key wifi_ssid_key
    fi

    wired_uuid=$(uuidgen)
    cat > "$TARGET/etc/NetworkManager/system-connections/dexos-wired.nmconnection" <<EOF
[connection]
id=DexOS Wired
uuid=$wired_uuid
type=ethernet
autoconnect=true
autoconnect-priority=100

[ethernet]

[ipv4]
method=auto

[ipv6]
method=auto
addr-gen-mode=default

[proxy]
EOF
    chmod 0600 "$TARGET"/etc/NetworkManager/system-connections/* 2>/dev/null || true
    if [ -x /usr/local/sbin/boot-order ]; then
        cp /usr/local/sbin/boot-order "$TARGET/usr/local/sbin/boot-order"
        chmod 0755 "$TARGET/usr/local/sbin/boot-order"
    fi
    [ -x /usr/local/sbin/grub-update ] || die "Falta grub-update en el Live."
    [ -x /usr/share/dexos/grub.d/31_dexos_other_os ] || die "Falta el detector GRUB de otros sistemas."
    cp /usr/local/sbin/grub-update "$TARGET/usr/local/sbin/grub-update"
    ln -sf grub-update "$TARGET/usr/local/sbin/update-grub"
    cp /usr/share/dexos/grub.d/31_dexos_other_os "$TARGET/etc/grub.d/31_dexos_other_os"
    chmod 0755 "$TARGET/usr/local/sbin/grub-update" "$TARGET/etc/grub.d/31_dexos_other_os"
}

install_grub_theme() {
    src=/usr/share/dexos/argon-grub-theme
    [ -f "$src/theme.txt" ] || die "Falta el tema Argon de GRUB en el medio Live."
    [ -f "$src/background.png" ] || die "Falta el fondo del tema Argon de GRUB."
    [ -f "$src/LICENCE.txt" ] || die "Falta la licencia del tema Argon de GRUB."

    dst="$TARGET/boot/grub/themes/argon"
    rm -rf "$dst"
    mkdir -p "$dst"
    cp -a "$src/." "$dst/"
    [ -f "$dst/theme.txt" ] || die "No se pudo instalar el tema Argon de GRUB."
    [ -f "$dst/background.png" ] || die "No se pudo instalar el fondo Argon de GRUB."
}

configure_boot() {
    root_uuid=$(blkid -s UUID -o value "$root_part")
    [ -n "$root_uuid" ] || die "No se pudo obtener el UUID de la raíz."
    efi_uuid=''
    [ -z "${efi_part:-}" ] || efi_uuid=$(blkid -s UUID -o value "$efi_part")

    cat > "$TARGET/etc/fstab" <<EOF
UUID=$root_uuid / ext4 defaults,noatime 0 1
EOF
    if [ -n "$efi_uuid" ]; then
        printf 'UUID=%s /boot/efi vfat umask=0077 0 2\n' "$efi_uuid" >> "$TARGET/etc/fstab"
    fi
    printf 'tmpfs /tmp tmpfs nosuid,nodev 0 0\n' >> "$TARGET/etc/fstab"

    mkdir -p "$TARGET/etc/mkinitfs"
    cat > "$TARGET/etc/mkinitfs/mkinitfs.conf" <<'EOF'
features="ata base scsi usb virtio ext4 nvme"
EOF
    kernel_version=''
    for module_dir in "$TARGET"/lib/modules/*; do
        [ -d "$module_dir" ] || continue
        kernel_version=${module_dir##*/}
    done
    [ -n "$kernel_version" ] || die "No se encontró el kernel instalado."

    say "Generando initramfs"
    chroot "$TARGET" /sbin/mkinitfs -c /etc/mkinitfs/mkinitfs.conf -o /boot/initramfs-lts "$kernel_version"
    [ -s "$TARGET/boot/initramfs-lts" ] || die "No se generó /boot/initramfs-lts."
    [ -s "$TARGET/boot/vmlinuz-lts" ] || die "No se instaló /boot/vmlinuz-lts."

    say "Instalando GRUB"
    bios_ok=0
    efi_ok=0
    if [ "$bios_install" -eq 1 ]; then
        if grub-install --boot-directory="$TARGET/boot" --target=i386-pc "$disk"; then
            bios_ok=1
        elif [ "$efi_install" -ne 1 ]; then
            die "Falló GRUB BIOS y no existe una alternativa UEFI."
        else
            warn "GRUB BIOS no pudo instalarse; se continuará con UEFI."
        fi
    fi

    if [ "$efi_install" -eq 1 ]; then
        [ -n "${efi_part:-}" ] || die "Se solicitó UEFI pero no hay ESP seleccionada."
        if [ -d /sys/firmware/efi/efivars ]; then
            grub-install --target=x86_64-efi --efi-directory="$TARGET/boot/efi" \
                --bootloader-id=DexOS --boot-directory="$TARGET/boot"
        else
            grub-install --target=x86_64-efi --efi-directory="$TARGET/boot/efi" \
                --bootloader-id=DexOS --boot-directory="$TARGET/boot" --no-nvram
        fi
        efi_ok=1
        if [ "$install_mode" = whole ]; then
            mkdir -p "$TARGET/boot/efi/EFI/BOOT"
            cp "$TARGET/boot/efi/EFI/DexOS/grubx64.efi" "$TARGET/boot/efi/EFI/BOOT/BOOTX64.EFI"
        fi
    fi
    [ "$bios_ok" -eq 1 ] || [ "$efi_ok" -eq 1 ] || die "No se instaló ningún cargador de arranque."

    say "Instalando tema Argon de GRUB"
    install_grub_theme

    cat > "$TARGET/etc/default/grub" <<EOF
GRUB_TIMEOUT=8
GRUB_DEFAULT=saved
GRUB_SAVEDEFAULT=false
GRUB_DISABLE_SUBMENU=y
GRUB_DISABLE_RECOVERY=true
GRUB_DISTRIBUTOR="DexOS Server"
GRUB_DISABLE_LINUX_UUID=false
GRUB_DISABLE_OS_PROBER=false
GRUB_THEME="/boot/grub/themes/argon/theme.txt"
GRUB_GFXMODE="1920x1080,auto"
GRUB_GFXPAYLOAD_LINUX=keep
GRUB_CMDLINE_LINUX="root=UUID=$root_uuid rootfstype=ext4"
GRUB_CMDLINE_LINUX_DEFAULT="quiet"
EOF

    say "Buscando Windows y otros Linux"
    mkdir -p "$TARGET/var/log"
    if [ -x "$TARGET/usr/bin/os-prober" ]; then
        chroot "$TARGET" /usr/bin/os-prober > "$TARGET/var/log/dexos-os-prober.log" 2>&1 || true
        if [ -s "$TARGET/var/log/dexos-os-prober.log" ]; then
            cat "$TARGET/var/log/dexos-os-prober.log"
        else
            echo "No se detectaron otros sistemas operativos."
        fi
    fi
    chroot "$TARGET" /usr/local/sbin/grub-update
    grep -Fq "root=UUID=$root_uuid" "$TARGET/boot/grub/grub.cfg" \
        || die "GRUB no quedó configurado con el UUID de la raíz."
    chroot "$TARGET" /usr/sbin/grub-set-default 0 >/dev/null 2>&1 || true
}

tsv_safe() {
    printf '%s' "$1" | tr '\t\r\n' '   '
}

show_installable_disks() {
    file="$WORK/check-disks"
    make_disk_list "$file"
    if [ ! -s "$file" ]; then
        echo "No hay discos de destino; el medio de instalación está oculto."
        return 0
    fi
    print_disk_menu "$file"
}

run_inventory() {
    command -v lsblk >/dev/null 2>&1 || die "Falta lsblk."
    file="$WORK/inventory-disks"
    make_disk_list "$file"
    while IFS= read -r inv_disk; do
        [ -n "$inv_disk" ] || continue
        disk=$inv_disk
        refresh_partition_nodes
        size_b=$(lsblk -bdnro SIZE "$disk" 2>/dev/null | tr -d ' ')
        size_h=$(tsv_safe "$(lsblk -dnro SIZE "$disk" 2>/dev/null | sed 's/[[:space:]]*$//')")
        model=$(tsv_safe "$(lsblk -dnro MODEL "$disk" 2>/dev/null | sed 's/[[:space:]]*$//')")
        tran=$(tsv_safe "$(lsblk -dnro TRAN "$disk" 2>/dev/null | sed 's/[[:space:]]*$//')")
        if disk_bios_capable; then bios=yes; else bios=no; fi
        if [ -d /sys/firmware/efi ]; then live_uefi=yes; else live_uefi=no; fi
        printf 'DISK\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$disk" "${size_b:-0}" "$size_h" "$model" "$tran" "$bios" "$live_uefi"
        partition_nodes_from_table | while IFS= read -r part; do
            psize_b=$(lsblk -bdnro SIZE "$part" 2>/dev/null | tr -d ' ')
            psize_h=$(tsv_safe "$(lsblk -dnro SIZE "$part" 2>/dev/null | sed 's/[[:space:]]*$//')")
            fs=$(tsv_safe "$(lsblk -dnro FSTYPE "$part" 2>/dev/null | sed 's/[[:space:]]*$//')")
            label=$(tsv_safe "$(lsblk -dnro LABEL "$part" 2>/dev/null | sed 's/[[:space:]]*$//')")
            partlabel=$(tsv_safe "$(lsblk -dnro PARTLABEL "$part" 2>/dev/null | sed 's/[[:space:]]*$//')")
            parttype=$(tsv_safe "$(lsblk -dnro PARTTYPE "$part" 2>/dev/null | tr '[:upper:]' '[:lower:]' | tr -d ' ')")
            mountpoints=$(tsv_safe "$(lsblk -dnro MOUNTPOINTS "$part" 2>/dev/null | sed '/^[[:space:]]*$/d' | paste -sd, -)")
            reason=$(root_partition_reason "$part")
            [ "$reason" = ok ] && eligible=yes || eligible=no
            if efi_partition_candidate "$part"; then efi=yes; else efi=no; fi
            [ -n "$fs" ] || fs='sin-formato'
            printf 'PART\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
                "$part" "$disk" "${psize_b:-0}" "$psize_h" "$fs" "$label" "$partlabel" \
                "$parttype" "$mountpoints" "$eligible" "$reason" "$efi"
        done
        free_regions_from_table | while IFS='	' read -r free_start free_sectors free_bytes; do
            [ -n "$free_start" ] || continue
            free_h=$(human_bytes "$free_bytes")
            scheme=$(partx -g -o SCHEME "$disk" 2>/dev/null | awk 'NF {print $1; exit}' | tr '[:upper:]' '[:lower:]')
            printf 'FREE\t%s\t%s\t%s\t%s\t%s\t%s\n' \
                "$disk" "$free_start" "$free_sectors" "$free_bytes" "$free_h" "${scheme:-unknown}"
        done
    done < "$file"
}

run_check() {
    preflight
    ensure_networkmanager
    say "NetworkManager"
    nmcli -f DEVICE,TYPE,STATE,CONNECTION device status || true
    say "Discos instalables"
    show_installable_disks
    echo
    echo "Comprobación completada: el instalador puede trabajar sin Internet."
}

acquire_install_lock() {
    if mkdir "$INSTALL_LOCK" 2>/dev/null; then
        LOCKED=1
        printf '%s\n' "$$" > "$INSTALL_LOCK/pid"
        return 0
    fi
    die "Ya hay una instalación de DexOS en curso."
}

validate_batch_config() {
    [ "${DEXOS_CONFIRM:-}" = INSTALLAR ] || die "Falta confirmación explícita DEXOS_CONFIRM=INSTALLAR."

    normalize_mdns_name "${DEXOS_HOSTNAME:-dexos-server.local}"
    admin_user=${DEXOS_ADMIN_USER:-admin}
    validate_user "$admin_user" || die "Usuario administrador no válido."
    admin_password=${DEXOS_ADMIN_PASSWORD:-}
    validate_password "$admin_password" || die "La contraseña del administrador debe tener al menos 8 caracteres y no contener ':'."
    root_password=${DEXOS_ROOT_PASSWORD:-$admin_password}
    validate_password "$root_password" || die "La contraseña root debe tener al menos 8 caracteres y no contener ':'."
    ssh_root_login=${DEXOS_SSH_ROOT_LOGIN:-no}
    case "$ssh_root_login" in yes|no) ;; *) die "DEXOS_SSH_ROOT_LOGIN debe ser yes o no." ;; esac
    timezone=${DEXOS_TIMEZONE:-UTC}
    validate_timezone "$timezone" || die "Zona horaria no disponible o no válida: $timezone"
    wifi_ssid=${DEXOS_WIFI_SSID:-}
    wifi_password=${DEXOS_WIFI_PASSWORD:-}
    validate_wifi_config "$wifi_ssid" "$wifi_password" || die "Configuración Wi-Fi inválida."

    install_mode=${DEXOS_INSTALL_MODE:-}
    case "$install_mode" in whole|coexist) ;; *) die "DEXOS_INSTALL_MODE debe ser whole o coexist." ;; esac
    disk=${DEXOS_DISK:-}
    case "$disk" in /dev/*) ;; *) die "Disco de destino no válido." ;; esac
    disk_file="$WORK/batch-disks"
    make_disk_list "$disk_file"
    grep -Fxq "$disk" "$disk_file" || die "$disk no es un disco instalable o es el medio Live."

    if [ "$install_mode" = whole ]; then
        disk_size=$(lsblk -bdnro SIZE "$disk" 2>/dev/null | tr -d ' ')
        [ "${disk_size:-0}" -ge "$MIN_DISK" ] || die "DexOS Server requiere un disco de al menos 4 GiB."
        if lsblk -nr -o MOUNTPOINTS "$disk" | grep -q '[^[:space:]]'; then
            die "$disk contiene una partición montada."
        fi
        root_part=''
        efi_part=''
        bios_install=1
        efi_install=1
        return 0
    fi

    refresh_partition_nodes
    root_part=${DEXOS_ROOT_PART:-}
    root_free_start=${DEXOS_ROOT_FREE_START:-}
    root_free_sectors=${DEXOS_ROOT_FREE_SECTORS:-}
    root_from_free=0

    if [ -n "$root_free_start" ] || [ -n "$root_free_sectors" ]; then
        [ -z "$root_part" ] || die "No mezcles una partición existente con espacio no asignado."
        case "$root_free_start:$root_free_sectors" in
            *[!0-9:]*|:*|*:) die "El espacio no asignado recibido no es válido." ;;
        esac
        free_region_valid "$root_free_start" "$root_free_sectors"             || die "El espacio no asignado seleccionado ya no existe o cambió de tamaño. Actualiza el inventario."
        root_from_free=1
    else
        [ -n "$root_part" ] || die "Falta una partición raíz o un espacio no asignado para coexistencia."
        reason=$(root_partition_reason "$root_part")
        [ "$reason" = ok ] || die "$root_part no puede usarse como raíz: $reason."
    fi

    efi_part=${DEXOS_EFI_PART:-}
    case "$efi_part" in none) efi_part='' ;; esac
    if [ -n "$efi_part" ]; then
        [ -z "$root_part" ] || [ "$efi_part" != "$root_part" ] || die "La raíz y la ESP no pueden ser la misma partición."
        efi_partition_candidate "$efi_part" || die "$efi_part no es una ESP/FAT del disco seleccionado."
        fs=$(lsblk -dnro FSTYPE "$efi_part" 2>/dev/null | tr '[:upper:]' '[:lower:]' | tr -d ' ')
        case "$fs" in vfat|fat|fat32) ;; *) die "$efi_part no contiene un filesystem FAT utilizable como ESP." ;; esac
    fi
    validate_boot_plan
}

perform_install() {
    acquire_install_lock
    rm -f /run/dexos-install-complete
    prepare_storage
    mount_target
    install_offline_packages
    write_target_config
    configure_boot

    say "Sincronizando datos"
    sync
    cleanup
    trap - EXIT HUP INT TERM
    printf '%s
' "$mdns_name" > /run/dexos-install-complete
    chmod 0600 /run/dexos-install-complete
    echo
    echo "DexOS Server se instaló correctamente."
    echo "Nombre mDNS: $mdns_name"
    echo "Después de arrancar puedes regenerar la detección de otros SO con: grub-update"
    echo "Puedes cambiar el sistema predeterminado con: boot-order"
    echo "Retira el medio Live y reinicia."
}

run_batch() {
    preflight
    validate_batch_config
    say "Instalación no interactiva validada"
    echo "Servidor: $mdns_name"
    echo "Usuario: $admin_user"
    echo "Disco: $disk"
    echo "Modo: $install_mode"
    echo "Wi-Fi tras reiniciar: ${wifi_ssid:-no preconfigurado}"
    if [ "$install_mode" = coexist ]; then
        if [ "${root_from_free:-0}" -eq 1 ]; then
            root_free_bytes=$((root_free_sectors * $(blockdev --getss "$disk" 2>/dev/null || echo 512)))
            echo "Raíz: espacio no asignado desde sector $root_free_start ($(human_bytes "$root_free_bytes"))"
        else
            echo "Raíz: $root_part"
        fi
        echo "ESP: ${efi_part:-ninguna}"
    fi
    perform_install
}

run_installer() {
    clear 2>/dev/null || true
    cat <<'EOF'
========================================
         DexOS Server Installer
========================================
Instalador offline con NetworkManager, mDNS y GRUB inteligente.
Puede usar un disco completo o coexistir con Windows/Linux.
Las particiones sin formato y el espacio no asignado también pueden elegirse como destino.
EOF

    preflight
    wifi_assistant
    collect_identity
    choose_layout

    say "Resumen"
    echo "Servidor:     $mdns_name"
    echo "Usuario:      $admin_user"
    echo "Root por SSH: $ssh_root_login"
    echo "Zona:         $timezone"
    echo "Disco:        $disk"
    echo "Modo:         $install_mode"
    echo "Wi-Fi:        ${wifi_ssid:-no preconfigurado}"
    if [ "$install_mode" = coexist ]; then
        if [ "${root_from_free:-0}" -eq 1 ]; then
            root_free_bytes=$((root_free_sectors * $(blockdev --getss "$disk" 2>/dev/null || echo 512)))
            echo "Raíz nueva: espacio no asignado ($(human_bytes "$root_free_bytes"))"
        else
            echo "Raíz a borrar: $root_part"
        fi
        echo "ESP conservada: ${efi_part:-ninguna}"
        echo "Otros sistemas: se conservarán y GRUB intentará detectarlos."
    else
        echo "ATENCIÓN: se borrará TODO el disco $disk."
    fi
    confirm "¿Iniciar la instalación?" || exit 0
    perform_install
}

case "${1:-}" in
    --wifi) wifi_assistant ;;
    --check) run_check ;;
    --inventory) run_inventory ;;
    --batch) run_batch ;;
    '') run_installer ;;
esac
