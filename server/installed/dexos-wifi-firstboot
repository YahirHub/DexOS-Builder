#!/sbin/openrc-run

description="Connect DexOS to the Wi-Fi configured by the installer"
CONFIG=/etc/dexos/wifi-firstboot.conf
PROFILE="DexOS WiFi"
LOG=/var/log/dexos-wifi-firstboot.log

depend() {
    need dbus wpa_supplicant networkmanager
    after udev-settle udev-postmount
}

log_msg() {
    printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S' 2>/dev/null || echo now)" "$*" >>"$LOG"
}

start() {
    [ -f "$CONFIG" ] || return 0

    : >"$LOG"
    chmod 0600 "$LOG"
    ebegin "Connecting configured Wi-Fi"

    . "$CONFIG"
    ssid=$(printf '%s' "${SSID_B64:-}" | base64 -d 2>/dev/null || true)
    password=$(printf '%s' "${PASSWORD_B64:-}" | base64 -d 2>/dev/null || true)
    if [ -z "$ssid" ]; then
        log_msg "Invalid installer Wi-Fi configuration: empty SSID"
        ewarn "Wi-Fi configuration is invalid; keeping $CONFIG for inspection"
        eend 0
        return 0
    fi

    rfkill unblock wifi >/dev/null 2>&1 || true
    nmcli radio wifi on >/dev/null 2>&1 || true

    dev=''
    i=0
    while [ "$i" -lt 30 ]; do
        dev=$(nmcli -t -f DEVICE,TYPE device status 2>/dev/null | awk -F: '$2=="wifi" && $1!="" {print $1; exit}')
        [ -n "$dev" ] && break
        sleep 1
        i=$((i + 1))
    done
    if [ -z "$dev" ]; then
        log_msg "No Wi-Fi device became available within 30 seconds"
        ewarn "No Wi-Fi adapter is ready yet; configuration will be retried on the next boot"
        eend 0
        return 0
    fi

    log_msg "Wi-Fi device ready: $dev; target SSID: $ssid"

    attempt=1
    while [ "$attempt" -le 3 ]; do
        einfo "Wi-Fi attempt $attempt/3"
        log_msg "Attempt $attempt/3: requesting an active scan for the configured SSID"
        nmcli device wifi rescan ifname "$dev" ssid "$ssid" >>"$LOG" 2>&1 || true
        sleep 3

        nmcli connection delete "$PROFILE" >/dev/null 2>&1 || true
        if [ -n "$password" ]; then
            if printf '%s\n' "$password" | nmcli --ask --wait 15 device wifi connect "$ssid" ifname "$dev" name "$PROFILE" hidden yes >>"$LOG" 2>&1; then
                rm -f "$CONFIG"
                unset password
                log_msg "Connected successfully; temporary installer credentials removed"
                eend 0
                return 0
            fi
        else
            if nmcli --wait 15 device wifi connect "$ssid" ifname "$dev" name "$PROFILE" hidden yes >>"$LOG" 2>&1; then
                rm -f "$CONFIG"
                log_msg "Connected successfully to open network; temporary installer configuration removed"
                eend 0
                return 0
            fi
        fi

        nmcli connection delete "$PROFILE" >/dev/null 2>&1 || true
        log_msg "Attempt $attempt failed"
        attempt=$((attempt + 1))
        [ "$attempt" -le 3 ] && sleep 4
    done

    unset password
    {
        printf '\nNetworkManager state after failure:\n'
        nmcli -f DEVICE,TYPE,STATE,CONNECTION device status 2>&1 || true
        printf '\nConfigured SSID scan result:\n'
        nmcli -t -f SSID device wifi list ifname "$dev" --rescan no 2>&1 | grep -F -- "$ssid" || true
    } >>"$LOG"
    ewarn "Could not connect to '$ssid'; configuration will be retried on the next boot"
    ewarn "Details: $LOG"
    eend 0
    return 0
}
