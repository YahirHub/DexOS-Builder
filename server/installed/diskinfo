#!/bin/sh
# Dashboard compacto de disco para Alpine Linux (ash)

TARGET="/"

# Obtener datos de df usando BusyBox
METRICS=$(df -h "$TARGET" | awk 'END {print $2, $3, $4, $5}')
set -- $METRICS
TOTAL="$1"
USED="$2"
FREE="$3"
PCT_NUM=$(echo "$4" | tr -d '%')

# Colores ANSI
RESET="\033[0m"
BOLD="\033[1m"
CYAN="\033[1;36m"
WHITE="\033[1;37m"
GRAY="\033[0;90m"

# Color dinámico de la barra según uso
if [ "$PCT_NUM" -ge 85 ]; then
    C_BAR="\033[1;31m"  # Rojo (>85%)
elif [ "$PCT_NUM" -ge 65 ]; then
    C_BAR="\033[1;33m"  # Amarillo (65%-84%)
else
    C_BAR="\033[1;32m"  # Verde (<65%)
fi

# Construir barra de 20 caracteres
BAR_LEN=20
FILLED=$(( (PCT_NUM * BAR_LEN) / 100 ))
[ "$FILLED" -gt "$BAR_LEN" ] && FILLED=$BAR_LEN
EMPTY=$(( BAR_LEN - FILLED ))
[ "$EMPTY" -lt 0 ] && EMPTY=0

BAR_FILL=""
i=0; while [ "$i" -lt "$FILLED" ]; do BAR_FILL="${BAR_FILL}█"; i=$((i+1)); done
BAR_EMPTY=""
i=0; while [ "$i" -lt "$EMPTY" ]; do BAR_EMPTY="${BAR_EMPTY}░"; i=$((i+1)); done

# Imprimir la tarjeta
printf "\n"
printf "  ${CYAN}┌─ ALMACENAMIENTO [${WHITE}%s${CYAN}] ──────────────────────────┐${RESET}\n" "$TARGET"
printf "  ${CYAN}│${RESET}  ${WHITE}Total:${RESET} %-7s ${WHITE}Usado:${RESET} %-7s ${WHITE}Libre:${RESET} %-7s   ${CYAN}│${RESET}\n" "$TOTAL" "$USED" "$FREE"
printf "  ${CYAN}│${RESET}  ${GRAY}[${RESET}%b%s${GRAY}%s]${RESET} %b%2d%%%b                   ${CYAN}│${RESET}\n" "$C_BAR" "$BAR_FILL" "$BAR_EMPTY" "$BOLD" "$PCT_NUM" "$RESET"
printf "  ${CYAN}└───────────────────────────────────────────────┘${RESET}\n\n"
